<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="9dp"
                android:startColor="#8CF3F6FC"
                android:endColor="#00F3F6FC" />
        </shape>
    </item>
    <item
        android:width="8dp"
        android:height="8dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#F3F6FC" />
        </shape>
    </item>
</layer-list>
